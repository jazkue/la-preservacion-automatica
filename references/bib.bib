@unpublished{lopezCreandoPiedraRosetta2015,
  title = {Creando La Piedra Rosetta Del Arte Digital | {{Solimán López}} | {{TEDxValladolid}}},
  author = {López, Solimán},
  date = {2015-10-29},
  url = {https://www.youtube.com/watch?v=0pWjD-sNLXE},
  urldate = {2024-04-04},
  abstract = {En este TEDx Talk combinado con performance artísitica, Solimán, nos plantea la necesidad de qué y cómo dejar un legado de la creatividad digital y contemporánea a futuras generaciones. Su propuesta, un museo de arte intangible en un disco duro, donde compilar y encapsular información, ideas y obras de arte digitales y albergar el conocimiento y todas las obras intangibles para ser transmitido a las generaciones venideras como la piedra rosetta del arte digital contemporáneo.  Un media artist que desarrolla su investigación artística en torno a la relación entre lo analógico-digital, el propio discurso del arte y la sociedad, la identidad y metafísica digital. Compagina su investigación artística con la dirección de ESAT LAB (Laboratorio de Investigación en Arte y Tecnología de la ESAT, Escuela Superior de Arte y Tecnología) y la labor docente. Actualmente comprometido con su obra más recientemente, el Harddiskmuseum, un museo de arte contemporáneo que vive dentro de un disco duro. This talk was given at a TEDx event using the TED conference format but independently organized by a local community. Learn more at http://ted.com/tedx}
}

